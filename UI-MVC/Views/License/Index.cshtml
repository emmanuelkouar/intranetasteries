@model IEnumerable<UI_MVC.Domain.Member>

@{
    ViewBag.Title = "Brevets";
    Layout = "~/Views/Shared/_Layout.cshtml";
}

<div class="blockContent">
    <h2>Membres @DateTime.Now.Year et leurs brevets</h2>


    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <p>
                Chercher par brevet de plongée: @Html.DropDownList("searchDiveLicense", (ViewBag.DiveLicense as SelectList), "Tous", new { @class = "form-control-custom" })
                <input type="submit" value="Chercher" class="btn btn-default" />
            </p>
        </div>
    }
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <p>
                Chercher par brevet de apnée: @Html.DropDownList("searchApneaLicense", (ViewBag.ApneaLicense as SelectList), "Tous", new { @class = "form-control-custom" })
                <input type="submit" value="Chercher" class="btn btn-default" />
            </p>
        </div>
    }
    @using (Html.BeginForm())
    {
        <div class="col-md-4">
            <p>
                Chercher par brevet de spécialisation: @Html.DropDownList("searchSpecLicense", (ViewBag.SpecLicense as SelectList), "Tous", new { @class = "form-control-custom" })
                <input type="submit" value="Chercher" class="btn btn-default" />
            </p>
        </div>
    }
    Nombre de membres: @Model.Count()
    <table class="table">
        <tr>
            <th>
                @Html.DisplayNameFor(model => model.LastName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.FirstName)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.CMASNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.LIFRASNumber)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.DiveLicenses)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.SpecialisationLicenses)
            </th>
            <th>
                @Html.DisplayNameFor(model => model.ApneaLicenses)
            </th>

            <th></th>
        </tr>

        @foreach (var item in Model)
        {
            <tr>
                <td>
                    @Html.DisplayFor(modelItem => item.LastName)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.FirstName)
                </td>

                <td>
                    @Html.DisplayFor(modelItem => item.CMASNumber)
                </td>
                <td>
                    @Html.DisplayFor(modelItem => item.LIFRASNumber)
                </td>
                <td>
                    @foreach (var lic in item.DiveLicenses)
                    {
                        @Html.DisplayFor(modelItem => lic.Level)<br/>
                    }

                </td>
                <td>
                    @foreach (var lic in item.SpecialisationLicenses)
                    {
                        @Html.DisplayFor(modelItem => lic.Level)<br />
                    }

                </td>
                <td>
                    @foreach (var lic in item.ApneaLicenses)
                    {
                        @Html.DisplayFor(modelItem => lic.Level)<br />
                    }

                </td>

                <td>
                    @if (User.Identity.Name.Equals("emmanuel.kouar@outlook.com"))
                    {
                        @Html.ActionLink("Modifier", "Edit", "Members", new { id = item.MemberId }, new { @class = "btn btn-default btnCustom" })
                    }
                    else
                    {
                        @Html.ActionLink("Modifier", "Edit", "Members", new { id = item.MemberId }, new { @class = "btn btn-default disabled btnCustom" })
                    }
                    @Html.ActionLink("Details", "Details", "Members", new { id = item.MemberId }, new { @class = "btn btn-default btnCustom" })
                </td>
            </tr>
        }

    </table>
    </div>
