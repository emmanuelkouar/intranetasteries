        <div role="tabpanel" class="tab-pane" id="MedVisit">
            @using (Html.BeginForm("Create", "Medical", new { id = Model.Member.MemberId }, FormMethod.Post))
            {
                @Html.AntiForgeryToken()

                <div class="form-horizontal">
                    <h4>Nouvelle visite médicale</h4>
                    <hr />
                    @Html.ValidationSummary(true, "", new { @class = "text-danger" })
                    @Html.HiddenFor(model => model.MedicalVisit.MedicalVisitId)

                    <div class="form-group">
                        @Html.LabelFor(model => model.MedicalVisit.Date, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.MedicalVisit.Date, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                            @Html.ValidationMessageFor(model => model.MedicalVisit.Date, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    <div class="form-group">
                        @Html.LabelFor(model => model.MedicalVisit.Notes, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            @Html.EditorFor(model => model.MedicalVisit.Notes, new { htmlAttributes = new { @class = "form-control" } })
                            @Html.ValidationMessageFor(model => model.MedicalVisit.Notes, "", new { @class = "text-danger" })
                        </div>
                    </div>

                    @*<div class="form-group">
                            @Html.LabelFor(model => model.MedicalVisit.ExpirationDate, htmlAttributes: new { @class = "control-label col-md-2" })
                            <div class="col-md-10">
                                @Html.EditorFor(model => model.MedicalVisit.ExpirationDate, new { htmlAttributes = new { @class = "form-control", type = "date" } })
                                @Html.ValidationMessageFor(model => model.MedicalVisit.ExpirationDate, "", new { @class = "text-danger" })
                            </div>
                        </div>*@

                    <div class="form-group">
                        @Html.LabelFor(model => model.MedicalVisit.AuthorizeApnea, htmlAttributes: new { @class = "control-label col-md-2" })
                        <div class="col-md-10">
                            <div class="checkbox">
                                @Html.EditorFor(model => model.MedicalVisit.AuthorizeApnea)
                                @Html.ValidationMessageFor(model => model.MedicalVisit.AuthorizeApnea, "", new { @class = "text-danger" })
                            </div>
                        </div>
                    </div>

                    <div class="form-group">
                        <div class="col-md-offset-2 col-md-10">
                            @Html.ActionLink("Retour", "Index", null, new { @class = "btn btn-default" })
                            <input type="submit" value="Enregistrer" class="btn btn-default" />
                        </div>
                    </div>

                </div>
            }


            <h4>Archives médicales</h4>


            @if (Model.Member.MedicalVisits.Count() != 0)
            {
                <table class="table">
                    <tr>
                        <th>
                            @Html.Label("Date")
                        </th>
                        <th>
                            @Html.Label("Autorisation apnée")
                        </th>
                        <th>
                            @Html.Label("Date d'échéance")
                        </th>
                        <th>
                            @Html.Label("Notes")
                        </th>
                        <th></th>

                    </tr>
                    @foreach (var item in Model.Member.MedicalVisits.OrderByDescending(i => i.ExpirationDate))
                {
                        <tr>
                            <td>
                                @Html.DisplayFor(modelItem => item.Date)
                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.AuthorizeApnea)
                            </td>
                            <td>
                                @if (item.ExpirationDate.CompareTo(DateTime.Now) < 0)
                                {
                                    <div style="color: red">
                                        @Html.DisplayFor(modelItem => item.ExpirationDate)
                                    </div>
                                }
                                else if (DateTime.Now.CompareTo(item.ExpirationDate.AddDays(-90)) >= 0)
                                {
                                    <div style="color: orange">
                                        @Html.DisplayFor(modelItem => item.ExpirationDate)
                                    </div>
                                }
                                else
                                {
                                    <div style="color: green">
                                        @Html.DisplayFor(modelItem => item.ExpirationDate)
                                    </div>
                                }



                            </td>
                            <td>
                                @Html.DisplayFor(modelItem => item.Notes)
                            </td>
                            <td>
                                @using (Html.BeginForm("Delete", "Medical", new { id = item.MedicalVisitId, memberId = Model.Member.MemberId }, FormMethod.Post))
                                {
                                    <input type="submit" value="Supprimer" class="btn btn-danger" />
                                }
                                @* @Html.ActionLink("Delete", "Delete", "Medical", new { id = item.MedicalVisitId }, new { @class = "btn btn-danger"})*@
                            </td>
                        </tr>
                    }
                </table>
            }
            else
            {
                @:<i>Pas d'archives en ce moment.</i>
                }


        </div>
