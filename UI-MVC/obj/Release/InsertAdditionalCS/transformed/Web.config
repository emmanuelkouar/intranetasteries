<configuration>
  <configSections>
    <!-- For more information on Entity Framework configuration, visit http://go.microsoft.com/fwlink/?LinkID=237468 -->
    <section name="entityFramework"
      type="System.Data.Entity.Internal.ConfigFile.EntityFrameworkSection, EntityFramework, Version=6.0.0.0, Culture=neutral, PublicKeyToken=b77a5c561934e089"
      requirePermission="false"/>
  </configSections>
  <connectionStrings>
    <!--<add name="DefaultConnection" connectionString="server=localhost;user id=root;pwd=admin;persistsecurityinfo=True;Database=asteries"  providerName="MySql.Data.MySqlClient" />-->
    <!--<add name="DefaultConnection" connectionString="Database=asteries;Data Source=eu-cdbr-azure-west-a.cloudapp.net;User Id=bce53f847242de;Password=5f216bd5"  providerName="MySql.Data.MySqlClient" />-->
    <add name="DefaultConnection"
      connectionString="Data Source=asteries.database.windows.net;Initial Catalog=intranetasteries;User ID=asteries;Password=Etoiles2000;Connect Timeout=15;Encrypt=True;TrustServerCertificate=False;ApplicationIntent=ReadWrite;MultiSubnetFailover=False"
      providerName="System.Data.SqlClient"/>
    <add name="UI_MVC.Migrations.MySqlHistoryContext" connectionString="UI_MVC.Migrations.MySqlHistoryContext_ConnectionString"
      providerName="System.Data.SqlClient"/>
  </connectionStrings>
  <appSettings>
    <add key="webpages:Version" value="3.0.0.0"/>
    <add key="webpages:Enabled" value="false"/>
    <add key="ClientValidationEnabled" value="true"/>
    <add key="UnobtrusiveJavaScriptEnabled" value="true"/>
  </appSettings>
  <!--
    For a description of web.config changes see http://go.microsoft.com/fwlink/?LinkId=235367.

    The following attributes can be set on the <httpRuntime> tag.
      <system.Web>
        <httpRuntime targetFramework="4.8" />
      </system.Web>
  -->
  <system.web>
    <authentication mode="None"/>
    <compilation targetFramework="4.8"/>
    <httpRuntime targetFramework="4.5.2"/>
    <!--Manually added by Manu to enable MySQL:-->
